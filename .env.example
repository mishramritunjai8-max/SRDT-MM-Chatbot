# Application Configuration
APP_NAME="Multimodal AI Chatbot MVP"
APP_ENV="development"
DEBUG=true
PORT=8000
HOST="127.0.0.1"
CORS_ORIGINS=["http://localhost:8501", "http://127.0.0.1:8501"]

# AI Providers Configuration
# Model selection: auto | gemini-2.5-flash | grok-2 | mock
DEFAULT_MODEL="auto"

# Google Gemini API (https://aistudio.google.com/)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_EMBEDDING_MODEL="text-embedding-004"

# xAI Grok API (https://console.x.ai/ - $25 free credits)
GROK_API_KEY=""
GROK_BASE_URL="https://api.x.ai/v1"
GROK_MODEL="grok-2"
GROK_VISION_MODEL="grok-2-vision-1212"

# Groq Cloud API (100% Free Forever - https://console.groq.com/)
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# Database Configuration
# Primary: PostgreSQL with pgvector (e.g. postgresql+psycopg://postgres:postgres@localhost:5432/mm_chatbot)
# Fallback / Local Zero-Setup: sqlite:///./mm_chatbot.db (uses in-memory vector adapter)
DATABASE_URL="sqlite:///./mm_chatbot.db"

# RAG & Document Processing
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K_RETRIEVAL=4
UPLOAD_DIR="./uploads"

# Web Search
SEARCH_PROVIDER="duckduckgo"
MAX_SEARCH_RESULTS=5

# Frontend Backend Connection
BACKEND_API_URL="http://127.0.0.1:8000"
